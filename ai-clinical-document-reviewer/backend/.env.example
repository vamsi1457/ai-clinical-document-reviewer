# Database Configuration
DATABASE_URL=postgresql://postgres:@localhost:5432/clinical_db

# AI Provider Configuration
# Set your AI API key (Google Gemini, OpenAI, or compatible endpoint)
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_PROVIDER=auto
AI_BASE_URL=

# Application & CORS Settings
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
MAX_FILE_SIZE_MB=10

# OCR Settings (leave blank for automatic detection or RapidOCR engine)
TESSERACT_CMD=
OCR_ENGINE=auto
